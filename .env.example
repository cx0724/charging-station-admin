# 生产环境请求通过同源 /api 代理转发，避免浏览器 CORS 与混合内容问题。
VITE_API_BASE_URL=/api

# 在 Vercel 项目设置中填写高德 Web JS API Key；不要将真实值提交到仓库。
VITE_AMAP_KEY=replace-with-your-amap-web-js-key

# 以下变量仅用于 Vite 开发服务器和 Vercel API 代理，不能使用 VITE_ 前缀。
# 从后端服务的安全配置中获取真实值；不要提交到 Git。
API_BACKEND_URL=http://your-backend-host:3000
